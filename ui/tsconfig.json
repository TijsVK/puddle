{
  "extends": "$app/tsconfig",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "allowJs": true,
    "checkJs": true,
    "skipLibCheck": true,
    "types": ["$app/types", "node"],
    "sourceMap": true
  },
  "include": ["src", "e2e", "tools", "scripts", "*.ts", "*.js"],
  "exclude": ["src/service-worker"]
}
